{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"customTemplates": [
		{
			"name": "page-no-title",
			"postTypes": [ "page" ],
			"title": "Page without title"
		}
	],
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	],
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "color": "#fbfaf7", "name": "Base", "slug": "base" },
				{ "color": "#1d1d1b", "name": "Contrast", "slug": "contrast" },
				{ "color": "#c2410c", "name": "Accent", "slug": "accent-1" },
				{ "color": "#fde8d7", "name": "Accent soft", "slug": "accent-2" },
				{ "color": "#000000", "name": "Strong contrast", "slug": "accent-3" },
				{ "color": "#5f5e5a", "name": "Muted text", "slug": "accent-4" },
				{ "color": "#f1efe9", "name": "Surface", "slug": "accent-5" },
				{ "color": "#d9d6ce", "name": "Border", "slug": "accent-6" }
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1200px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "name": "Tiny", "size": "8px", "slug": "20" },
				{ "name": "X-Small", "size": "16px", "slug": "30" },
				{ "name": "Small", "size": "clamp(20px, 2.5vw, 32px)", "slug": "40" },
				{ "name": "Regular", "size": "clamp(32px, 4vw, 48px)", "slug": "50" },
				{ "name": "Large", "size": "clamp(48px, 6vw, 80px)", "slug": "60" },
				{ "name": "X-Large", "size": "clamp(64px, 9vw, 128px)", "slug": "70" }
			],
			"units": [ "px", "em", "rem", "%", "vw", "vh", "svh" ]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"writingMode": true,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
					"name": "System sans",
					"slug": "body"
				},
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
					"name": "Headings",
					"slug": "heading"
				},
				{
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
					"name": "Monospace",
					"slug": "mono"
				}
			],
			"fontSizes": [
				{ "name": "Small", "size": "0.875rem", "slug": "small", "fluid": false },
				{ "name": "Medium", "size": "1.0625rem", "slug": "medium", "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "name": "Large", "size": "1.375rem", "slug": "large", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "name": "Extra large", "size": "2rem", "slug": "x-large", "fluid": { "min": "1.625rem", "max": "2.25rem" } },
				{ "name": "Huge", "size": "3rem", "slug": "xx-large", "fluid": { "min": "2.25rem", "max": "3.75rem" } }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "name": "Soft", "shadow": "0 2px 12px #0000001a", "slug": "soft" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|30",
			"padding": {
				"left": "var:preset|spacing|40",
				"right": "var:preset|spacing|40"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.5"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|contrast" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var:preset|color|accent-1" }
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "600",
					"lineHeight": "1.15"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|medium" } },
			"h5": { "typography": { "fontSize": "var:preset|font-size|medium" } },
			"h6": { "typography": { "fontSize": "var:preset|font-size|small" } },
			"button": {
				"border": { "radius": "999px" },
				"color": {
					"background": "var:preset|color|contrast",
					"text": "var:preset|color|base"
				},
				"spacing": {
					"padding": {
						"top": "0.7em",
						"bottom": "0.7em",
						"left": "1.4em",
						"right": "1.4em"
					}
				},
				"typography": { "fontWeight": "600" },
				":hover": {
					"color": {
						"background": "var:preset|color|accent-1",
						"text": "var:preset|color|base"
					}
				},
				":focus": {
					"color": {
						"background": "var:preset|color|accent-1",
						"text": "var:preset|color|base"
					}
				}
			},
			"caption": {
				"color": { "text": "var:preset|color|accent-4" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "var:preset|font-size|medium" }
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|accent-4" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			},
			"core/post-terms": {
				"typography": { "fontSize": "var:preset|font-size|small" }
			},
			"core/quote": {
				"border": {
					"left": { "color": "var:preset|color|accent-1", "style": "solid", "width": "3px" }
				},
				"spacing": {
					"padding": { "left": "var:preset|spacing|40" }
				},
				"typography": { "fontSize": "var:preset|font-size|large" }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|accent-6" }
			},
			"core/site-title": {
				"typography": {
					"fontWeight": "700",
					"fontSize": "var:preset|font-size|large"
				},
				"elements": {
					"link": { "typography": { "textDecoration": "none" } }
				}
			},
			"core/details": {
				"border": {
					"bottom": { "color": "var:preset|color|accent-6", "style": "solid", "width": "1px" }
				},
				"spacing": {
					"padding": { "top": "var:preset|spacing|30", "bottom": "var:preset|spacing|30" }
				}
			}
		}
	}
}
